# news-generator-generic environment. Copy to .env and fill in the keys.
# Loaded once at process start by python-dotenv (and by docker compose env_file); restart after editing.
#
# Per-machine lines (everything else is the same on both boxes):
#   Apple Silicon host (<mac-host>, ComfyUI Desktop):
#     *_COMFYUI_BASE_URL=http://<mac-host>:8123   TTS_OPENAI_BASE_URL=http://<mac-host>:8184/v1
#     TTS_OPENAI_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-bf16   NEWS_CONTEXT_RERANK_ENDPOINT=http://<mac-host>:8182/v1/rerank
#     VIDEO_COMFYUI_WORKFLOW=comfyui-workflows/video_ltx2_3_ia2v-extend-mac-q8.json  (Q8 GGUF; see docs/mac/)
#     HERO/AVATAR templates: image_qwen_image_2_1.json / avatar_image_z_image_turbo_1080p.json (no fp8 on MPS)
#   CUDA host (<cuda-host>):
#     VIDEO_COMFYUI_BASE_URL=http://<cuda-host>:8188   AVATAR_COMFYUI_BASE_URL=http://<cuda-host>:8189 (second instance, comfy-kitchen per ComfyUI requirements.txt, for int8 Qwen templates)
#     TTS_OPENAI_BASE_URL=http://<cuda-host>:8091/v1
#     TTS_OPENAI_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base   NEWS_CONTEXT_RERANK_ENDPOINT=http://<cuda-host>:8007/v1/rerank
#     VIDEO_COMFYUI_WORKFLOW=comfyui-workflows/video_ltx2_3_ia2v-extend.json  (stock fp8 template)
#     HERO/AVATAR templates: image_qwen_Image_2512.json


# ---- Avatar images (ComfyUI image templates under comfyui-workflows/avatar/)
AVATAR_API_KEY=
AVATAR_COMFYUI_BASE_URL=http://<mac-host>:8123
AVATAR_COMFYUI_TIMEOUT_SECONDS=600
AVATAR_COMFYUI_WORKFLOW=comfyui-workflows/avatar/avatar_image_z_image_turbo_1080p.json
AVATAR_DEFAULT_HEIGHT=720
AVATAR_DEFAULT_WIDTH=1280
AVATAR_NEGATIVE_PROMPT=blurry, low quality, distorted, deformed, ugly, bad anatomy, watermark, text, signature
AVATAR_STORAGE_PATH=assets/avatars

# ---- TTS (services/tts.py): an OpenAI-compatible /v1/audio/speech server (Qwen3-TTS).
TTS_OPENAI_BASE_URL=http://<mac-host>:8184/v1
TTS_OPENAI_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-bf16
TTS_OPENAI_API_KEY=local
TTS_OPENAI_TIMEOUT_SECONDS=360

# ---- Pipeline: search, ranking, script, prompts, hero images
NEWS_DEFAULT_WPM=145
NEWS_CONTEXT_MAX_SENTENCES=80
NEWS_CONTEXT_MIN_SENTENCE_CHARS=40
NEWS_CONTEXT_RERANK_BACKEND=http
NEWS_CONTEXT_RERANK_ENABLED=true
NEWS_CONTEXT_RERANK_ENDPOINT=http://<mac-host>:8182/v1/rerank
NEWS_CONTEXT_RERANK_MODEL=bge-reranker-v2-m3
NEWS_CONTEXT_RERANK_TIMEOUT_SECONDS=60
NEWS_CONTEXT_RERANK_TOP_N=20
NEWS_SOURCE_RANK_ENABLED=true
NEWS_SOURCE_RANK_CANDIDATES=50
NEWS_SOURCE_RANK_QUERY=artificial intelligence and technology news
NEWS_CONTEXT_WINDOW_SENTENCES=0
NEWS_INTENDED_VIDEO_MAX_SECONDS=30
NEWS_OUTPUT_DIRECTORY=output
NEWS_SUMMARIZE_PROMPT=
NEWS_SUMMARIZE_PROMPT_FILE=prompts/generic-news-reporter.md
NEWS_VIDEO_PROMPT=
NEWS_VIDEO_PROMPT_FILE=prompts/video-anchor-scene.md
NEWS_VIDEO_SOUND_PROMPT=
NEWS_VIDEO_SOUND_PROMPT_FILE=prompts/video-sound.md
NEWS_HERO_PROMPT=
NEWS_HERO_PROMPT_FILE=prompts/hero-image.md
# Segment hero images: template file name from comfyui-workflows/avatar used unless the profile picks one.
HERO_COMFYUI_WORKFLOW=image_qwen_image_2_1.json

# ---- LLM (OpenAI-compatible: llama.cpp, vLLM, SGLang, Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=http://<mac-host>:8180/v1
OPENAI_DEFAULT_TIMEOUT_SECONDS=300
OPENAI_MODEL=qwen3.8-27b
OPENAI_REASONING_EFFORT=none

# ---- SearXNG
SEARXNG_BASE_URL=http://<mac-host>:8888
SEARXNG_DEFAULT_CATEGORIES=news,general
SEARXNG_DEFAULT_LANGUAGE=en
SEARXNG_DEFAULT_MAX_AGE_DAYS=1
SEARXNG_DEFAULT_MAX_ARTICLES=5
SEARXNG_DEFAULT_SAFESEARCH=1
SEARXNG_DEFAULT_TIME_RANGE=
SEARXNG_DEFAULT_TIMEOUT_SECONDS=20

# ---- Video (ComfyUI LTX template, size, timeout)
VIDEO_COMFYUI_BASE_URL=http://<mac-host>:8123
VIDEO_COMFYUI_FREE_BEFORE_RUN=true
VIDEO_COMFYUI_FPS=24
VIDEO_COMFYUI_HEIGHT=704
VIDEO_COMFYUI_OUTPUT_PREFIX=video/news-generator
VIDEO_COMFYUI_PROMPT_ENHANCE=false
VIDEO_COMFYUI_TIMEOUT_SECONDS=5400
VIDEO_COMFYUI_WIDTH=1280
VIDEO_COMFYUI_WORKFLOW=comfyui-workflows/video_ltx2_3_ia2v-extend-mac-q8.json

# ---- Admin tenant, storage, logging
ADMIN_API_KEY=
ADMIN_TENANT_NAME=Admin
ADMIN_TENANT_SLUG=admin
DATA_DIRECTORY=data
SEQ_LOGGING_API_KEY=
SEQ_LOGGING_BASE_URL=http://localhost:5341

# ---- Article extraction (crawl4ai)
CRAWL4AI_API_URL=http://<mac-host>:11235
CRAWL4AI_API_TOKEN=
# Article extraction (crawl4ai). Extraction is best effort; a source falls back to its search snippet.
ARTICLE_EXTRACTION_ENABLED=true
ARTICLE_EXTRACT_FILTER=fit
ARTICLE_EXTRACT_TIMEOUT_SECONDS=45
ARTICLE_EXTRACT_MAX_WORDS=1500
ARTICLE_EXTRACT_MIN_WORDS=120
ARTICLE_EXTRACT_CONCURRENCY=3
ARTICLE_EXTRACT_SKIP_DOMAINS=youtube.com,youtu.be,facebook.com,instagram.com,tiktok.com,x.com,twitter.com,reddit.com,threads.net,pinterest.com
ARTICLE_EXTRACT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
ARTICLE_EXTRACT_PRUNE_THRESHOLD=0.48
# LLM context window. auto = min(model max, LLM_CONTEXT_CAP) on Ollama; vLLM/SGLang are fixed at launch and only reported.

# ---- LLM context window (see README, LLM Context Window)
LLM_CONTEXT_SIZE=131072
LLM_CONTEXT_CAP=131072
LLM_RESERVE_TOKENS=2048
LLM_CONTEXT_FALLBACK=8192
# Segmented rendering: every script is split into chunks of at most SEGMENT_MAX_WORDS, each narrated and rendered on its own, then appended.

# ---- Segmented rendering and hero compositing
SEGMENT_ENABLED=true
SEGMENT_MAX_WORDS=40
# Wan2.2 S2V video template (comfyui-workflows/video_wan2_2_14B_s2v.json): renders 77-frame segments at 16 fps,
# chained to cover the narration. Sizes are multiples of 16. Point VIDEO_COMFYUI_WORKFLOW at the file to use it.
VIDEO_WAN_S2V_WIDTH=1280
VIDEO_WAN_S2V_HEIGHT=720
VIDEO_WAN_S2V_FPS=16
# LTX fades the last frames of a clip: render this much past the narration and cut it off after download. 0 disables.
VIDEO_LTX_TAIL_PAD_SECONDS=0.5
# Chunk continuity: true starts each chunk's render from the last frame of the previous chunk (one continuous take, may drift);
# false restarts every chunk from the anchor image (hard cut, pose snaps back to the reference).
SEGMENT_CONTINUE_FROM_LAST_FRAME=true
# Hero compositing: fixed = measure the panel once per run, record it in hero-placement.json, paint the hero there on every frame (no movement);
# key = per-frame green key with tracking; locked = fill the measured panel shape and hold it still when the camera does.
HERO_COMPOSITE_MODE=fixed
# Pixels the hero is grown past the measured panel edge in fixed and locked modes, so no green peeks out. Too much paints over the bezel.
HERO_COMPOSITE_BLEED_PX=4
